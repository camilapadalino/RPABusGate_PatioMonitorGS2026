    {
      "parameters": {
        "jsCode": "const registros = $input.all();\n\nconst eventos = registros\n  .map(item => item.json)\n  .filter(item => item.dispositivo && item.evento)\n  .map(item => ({\n    id: item.id,\n    dispositivo: item.dispositivo,\n    evento: item.evento,\n    distancia_cm: item.distancia_cm,\n    movimento: item.movimento,\n    tipo_registro: item.tipo_registro,\n    data_hora: item.data_hora\n  }))\n  .sort((a, b) =>\n    new Date(b.data_hora) - new Date(a.data_hora)\n  );\n\nreturn [\n  {\n    json: {\n      sucesso: true,\n      total: eventos.length,\n      eventos\n    }\n  }\n];\n"
      },
